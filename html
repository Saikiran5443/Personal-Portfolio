body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #0b1220;
    color: #e5e7eb;
}

/* HERO */
.hero {
    text-align: center;
    padding: 80px 20px;
    background: linear-gradient(135deg, #0f172a, #1e293b);
}

.hero h1 {
    font-size: 42px;
    color: #38bdf8;
}

.hero p {
    font-size: 18px;
    color: #cbd5e1;
}

/* SECTIONS */
section {
    max-width: 900px;
    margin: auto;
    padding: 50px 20px;
}

h2 {
    color: #38bdf8;
}

/* CARD */
.card {
    background: #111827;
    padding: 20px;
    border-radius: 10px;
    margin-top: 15px;
    border: 1px solid #1f2937;
}

/* SKILLS */
.skills span {
    display: inline-block;
    background: #38bdf8;
    color: #0b1220;
    padding: 6px 12px;
    margin: 5px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: bold;
}

/* CONTACT LINKS */
a {
    color: #38bdf8;
    text-decoration: none;
}

/* FOOTER */
footer {
    text-align: center;
    padding: 20px;
    background: #111827;
    color: #94a3b8;
}
